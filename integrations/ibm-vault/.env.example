# Stable origin serving the bridge and secure onboarding page. No trailing slash.
APP_ORIGIN=https://your-onboarding-bridge.vercel.app
# Fixed trusted Vault endpoint. Never accepted from a chat message or browser request.
VAULT_ADDR=https://vault.example.com:8200
VAULT_NAMESPACE=
# Only mounts beginning with this prefix can be managed.
ALLOWED_MOUNT_PREFIX=onboard-
# Generate two independent values with: openssl rand -hex 32
PLAN_SIGNING_KEY=
WXO_BRIDGE_API_KEY=
# Copy public identifiers from: orchestrate channels webchat embed --agent-name rpt_vault_concierge
WXO_HOST_URL=
WXO_ORCHESTRATION_ID=
WXO_AGENT_ID=
WXO_AGENT_ENVIRONMENT_ID=
# Dedicated KV-only chat: do not reuse the general agent.
WXO_KV_MOUNT_AGENT_ID=
WXO_KV_MOUNT_AGENT_ENVIRONMENT_ID=
WXO_DEPLOYMENT_PLATFORM=
WXO_CRN=
# ADK API instance URL; this is NOT the browser chat hostURL.
WXO_INSTANCE_URL=https://api.dl.watson-orchestrate.ibm.com/instances/20261104-0014-2170-40e0-623668130968
# PEM content for server-side RS256 signing; register its public key with WXO.
WXO_CHAT_PRIVATE_KEY=
# Optional trusted parent origin for /chat framing. /onboard cannot be framed.
WEBSITE_ORIGIN=https://rpt-vault-concierge-demo-beryl.vercel.app
# Required for short review links and single-use operation approvals.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vault token policies approved for admin queue sign-in; token lookup-self must be permitted.
ADMIN_REVIEW_VAULT_POLICIES=hcp-root,root
